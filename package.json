{
  "name": "kheoo-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client side",
    "server side"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm --prefix \"client side\" run dev",
    "dev:server": "npm --prefix \"server side\" run dev",
    "build:client": "npm --prefix \"client side\" run build",
    "build:server": "npm --prefix \"server side\" run build",
    "install:all": "npm install --prefix \"client side\" && npm install --prefix \"server side\""
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "dependencies": {
    "mongodb": "^7.5.0"
  }
}
